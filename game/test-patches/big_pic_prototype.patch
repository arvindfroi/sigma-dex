diff --git a/src/battle_controllers.c b/src/battle_controllers.c
index 63c899bc..7c11967d 100644
--- a/src/battle_controllers.c
+++ b/src/battle_controllers.c
@@ -2362,6 +2362,38 @@ void BtlController_HandleSetRawMonData(enum BattlerId battler)
     BtlController_Complete(battler);
 }
 
+// SIGMA 96x96 PROTOTYPE: every wild/opponent Pokemon is shown with the picture in
+// src/data/sigma_big_pic.h, cut into hardware sprites (the GBA's largest is 64x64):
+// 96x96 = 64x64 + 32x64 + 64x32 + 32x32, each block's tiles stored one after another.
+#include "data/sigma_big_pic.h"
+#if BIG_PIC_FRAME == 96
+#define BIG_PIC_TOP (-48)   // the picture's top above the sprite's centre (96 tall, bottom 48 below)
+static const struct Subsprite sBigPicSubsprites[] = {
+    {.x = -48, .y = BIG_PIC_TOP,      .shape = ST_OAM_SQUARE,      .size = ST_OAM_SIZE_3, .tileOffset = 0},
+    {.x = 16,  .y = BIG_PIC_TOP,      .shape = ST_OAM_V_RECTANGLE, .size = ST_OAM_SIZE_3, .tileOffset = 64},
+    {.x = -48, .y = BIG_PIC_TOP + 64, .shape = ST_OAM_H_RECTANGLE, .size = ST_OAM_SIZE_3, .tileOffset = 96},
+    {.x = 16,  .y = BIG_PIC_TOP + 64, .shape = ST_OAM_SQUARE,      .size = ST_OAM_SIZE_2, .tileOffset = 128},
+};
+#else
+static const struct Subsprite sBigPicSubsprites[] = {
+    {.x = -32, .y = -32, .shape = ST_OAM_SQUARE, .size = ST_OAM_SIZE_3, .tileOffset = 0},
+};
+#endif
+static const struct SubspriteTable sBigPicTable[] = {{ARRAY_COUNT(sBigPicSubsprites), sBigPicSubsprites}};
+
+static void SigmaShowBigPic(enum BattlerId battler)
+{
+    struct Sprite *sprite = &gSprites[gBattlerSpriteIds[battler]];
+    struct SpriteSheet sheet = {sBigPicGfx, sizeof(sBigPicGfx), 0x5A5A};
+    u16 tile = LoadSpriteSheet(&sheet);
+    sprite->usingSheet = TRUE;
+    sprite->sheetTileStart = tile;
+    sprite->oam.tileNum = tile;
+    SetSubspriteTables(sprite, sBigPicTable);
+    sprite->subspriteMode = SUBSPRITES_IGNORE_PRIORITY;
+    LoadPalette(sBigPicPal, OBJ_PLTT_ID(battler), PLTT_SIZE_4BPP);
+}
+
 void BtlController_HandleLoadMonSprite(enum BattlerId battler)
 {
     u32 y;
@@ -2392,6 +2424,8 @@ void BtlController_HandleLoadMonSprite(enum BattlerId battler)
     gSprites[gBattlerSpriteIds[battler]].data[2] = species;
     gSprites[gBattlerSpriteIds[battler]].oam.paletteNum = battler;
     StartSpriteAnim(&gSprites[gBattlerSpriteIds[battler]], 0);
+    if (!IsOnPlayerSide(battler))
+        SigmaShowBigPic(battler);   // SIGMA 96x96 PROTOTYPE
 
     if (!(gBattleTypeFlags & BATTLE_TYPE_GHOST))
         SetBattlerShadowSpriteCallback(battler, species);
